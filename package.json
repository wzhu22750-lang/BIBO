{
  "name": "bibu-private-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/tests/**/*.ts\" \"*.{json,ts,md}\" \"public/demo/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"supabase/tests/**/*.ts\" \"*.{json,ts,md}\" \"public/demo/*.md\"",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/push-notifications": "8.1.2",
    "@fontsource/press-start-2p": "^5.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "pixelarticons": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
